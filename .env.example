# העתיקי את הקובץ הזה לקובץ בשם .env ומלאי ערכים אמיתיים.
# את קובץ .env לא מעלים ל-GitHub! (הוא מופיע ב-.gitignore)

# --- OpenRouter (ספק המודלים) ---
# יוצרים מפתח ב: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# המודל שישמש כברירת מחדל
# מודלים חינמיים מתחלפים לפעמים. הרשימה העדכנית: https://openrouter.ai/models?max_price=0
DEFAULT_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# --- LangSmith (ניטור) ---
# יוצרים מפתח ב: https://smith.langchain.com  (Settings -> API Keys)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=log-sentinel

# --- מייל (אופציונלי. אם ריק, המיילים יישמרו בתיקייה outbox/ ולא יישלחו) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
